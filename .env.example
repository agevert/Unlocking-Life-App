# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# The publishable (formerly "anon") key. Safe in the browser: row-level security protects the data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# The secret (formerly "service_role") key. Server only: used for account deletion and reminder emails.
SUPABASE_SECRET_KEY=sb_secret_xxx

# --- Public URL of the app (no trailing slash) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Sign-in options ---
# Set to "true" after enabling Google in Supabase → Authentication → Providers.
NEXT_PUBLIC_GOOGLE_AUTH=false

# --- Claude (console.anthropic.com → API keys) ---
ANTHROPIC_API_KEY=sk-ant-xxx
ANTHROPIC_MODEL=claude-sonnet-5-5
# Sparring requests allowed per user per 24 hours.
SPAR_DAILY_LIMIT=8

# --- Reminder emails (optional; resend.com) ---
RESEND_API_KEY=
REMINDER_FROM="Threefold <review@your-domain.com>"
# Vercel sends this automatically as a Bearer token to cron routes when set.
CRON_SECRET=generate-a-long-random-string
